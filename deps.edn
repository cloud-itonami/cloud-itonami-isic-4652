{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj).
 ;;
 ;; Like the fuel-wholesale / general-trading / metal-wholesale /
 ;; textile-wholesale / waste-wholesale / computer-and-software-wholesale
 ;; siblings, this telecom/electronics-equipment-wholesale vertical is
 ;; SELF-CONTAINED: there is no `kotoba-lang/telecomtrade` to delegate
 ;; supply-chain-sourcing validation to, so the covered-manufacturer /
 ;; buyer-category checks live as direct entity/catalog reads in
 ;; `telecomtrade.governor` rather than wrapping an external lib. This
 ;; repo is standalone (forkable outside the workspace); the :local/root
 ;; paths only resolve inside the monorepo checkout -- a standalone fork
 ;; should override them with git coordinates.
 ;;
 ;; jp-go-digital-design-system (DADS) is the workspace's BASE design
 ;; system -- it supplies the stylesheet `telecomtrade.render-html` pours
 ;; into `docs/samples/operator-console.html`, so the generated console
 ;; looks like every other cloud-itonami operator console instead of
 ;; carrying its own hand-rolled CSS. Pinned by git sha (not :local/root)
 ;; so a standalone fork outside the monorepo still resolves it.
 :deps {io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}
        io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "telecomtrade.sim"]}
  ;; clojure -M:dev:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html by actually running the actor
  ;; stack. Throws rather than writing a page whose run produced no HARD
  ;; governor hold -- see `telecomtrade.render-html/-main`.
  :render-html {:main-opts ["-m" "telecomtrade.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
